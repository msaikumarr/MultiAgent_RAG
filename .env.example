# Multi-Model LLM API Keys
# Google Gemini API (Recommended for free/accessible tier)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (Recommended: automatic fallback once Gemini's free-tier daily quota
# runs out, or on any Gemini error. Get a free key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Model Provider Selection
# Options: "gemini", "openai", "groq", "ollama", "mock"
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-2.5-flash

# Verification Model (Can be same or a secondary model for multi-model verification)
VERIFICATION_LLM_PROVIDER=gemini
VERIFICATION_LLM_MODEL=gemini-3.5-flash-lite

# Groq fallback models used automatically once Gemini is unavailable/quota-exhausted.
# Only used if GROQ_API_KEY is set above.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VERIFICATION_MODEL=openai/gpt-oss-120b

# Embedding Model Selection
# Default: sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# RAG & Chunking Configurations
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=5
